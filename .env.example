# Copy to .env for local development. The pipeline runs WITHOUT any of these
# set (frozen snapshot + replayed LLM responses) — they are only needed to
# refresh data or run the reasoning layer live.

# Razorpay sandbox / test-mode API — only for scripts/pull_razorpay_sandbox.py
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM reasoning layer — only when RECON_LLM_REPLAY_ONLY=0
ANTHROPIC_API_KEY=
RECON_LLM_MODEL=claude-sonnet-5
RECON_LLM_REPLAY_ONLY=1
